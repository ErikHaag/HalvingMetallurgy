<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace />
		<AssemblyName>HalvingMetallurgy</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<OpusPath>C:\Users\green\source\repos\HalvingMetallurgy\TestEnvironment\modded</OpusPath>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup>
		<AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="DevLightning">
			<HintPath>$(OpusPath)\DevLightning.exe</HintPath>
			<CopyLocal>False</CopyLocal>
		</Reference>
		<Reference Include="Mono.Cecil">
			<HintPath>$(OpusPath)\Mono.Cecil.dll</HintPath>
			<CopyLocal>False</CopyLocal>
		</Reference>
		<Reference Include="MonoMod">
			<HintPath>$(OpusPath)\MonoMod.Patcher.dll</HintPath>
			<CopyLocal>False</CopyLocal>
		</Reference>
		<Reference Include="MonoMod.Utils">
			<HintPath>$(OpusPath)\MonoMod.Utils.dll</HintPath>
			<CopyLocal>False</CopyLocal>
		</Reference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Symbol svgs\" />
	</ItemGroup>

</Project>
